# Adres publiczny serwisu (bez ukośnika na końcu) – używany w mailach, sitemap i danych strukturalnych
SITE_URL="https://energiawbiznesie.online"

# Baza danych. Lokalnie SQLite; produkcyjnie MariaDB/MySQL (mysql://…) albo PostgreSQL (postgresql://…) – zob. README.
DATABASE_URL="file:./dev.db"

# Katalog na pliki przesyłane przez klientów (faktury, umowy). Poza katalogiem public!
STORAGE_DIR="./storage"

# Pierwsze konto administratora tworzone przez `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ZmienToHaslo123!"

# Wysyłka e-mail (SMTP). Bez tych danych wiadomości są tylko zapisywane w logu serwera.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Energia w Biznesie <biuro@energiawbiznesie.online>"
# Na ten adres trafiają powiadomienia o nowych wnioskach i zapytaniach
NOTIFY_EMAIL="biuro@energiawbiznesie.online"
# „Zamów telefon – oddzwonimy w 60 sekund”: zgłoszenie trafia na NOTIFY_EMAIL (temat „PILNE”) i do panelu (Zapytania).
# Livespace CRM (call center): każde zamówienie z portalu i zgłoszenie ze strony trafia do Livespace jako kontakt + zadanie;
# firma o tym samym NIP (osoba o tym samym e-mailu/telefonie) jest aktualizowana, faktury dołączane jako pliki,
# „Zamów telefon” – jako zadanie PILNE z powiadomieniem. Klucze: Livespace → Ustawienia konta → API → Użytkownicy → wiersz „Użytkownik API”.
# LIVESPACE_URL="https://twojafirma.livespace.io"
# LIVESPACE_API_KEY=""
# LIVESPACE_API_SECRET=""
# LIVESPACE_USER_ID=""          # kto dostaje zadania i powiadomienia – jedno ID albo kilka po przecinku (pierwsza osoba = właściciel)
#                               # ID: panel portalu → Dane firmy → Livespace → Sprawdź połączenie
# LIVESPACE_TASK_TYPE_ID=""     # opcjonalnie; domyślnie typ zadania „Telefon”/„Rozmowa”/„Call”
# LIVESPACE_SOURCE=""           # opcjonalnie: źródło kontaktu istniejące w Livespace, np. „Strona www”
# LIVESPACE_FIELDS='{"taryfa":"ID pola","zuzycie":"ID pola"}'  # opcjonalnie: pola dodatkowe kontaktu (taryfa, zuzycie, taryfa_gaz, zuzycie_gaz,
#                               # ppe, sprzedawca, osd, koniec_umowy, moc_umowna, lata, model_ceny)
# FILE_LINK_SECRET=""           # opcjonalnie: klucz podpisu linków do faktur dla Livespace (domyślnie pochodna LIVESPACE_API_SECRET)
# LIVESPACE_GROUP_ID=""         # opcjonalnie: grupa kontaktów (np. „kontaktowy”) – ID: Livespace → Ustawienia konta → API → Kontakty
# Inny system call center: POST JSON {type, id, phone, name, topic, page, createdAt}
# CALLBACK_WEBHOOK_URL="https://call-center.example.com/api/callback"
# CALLBACK_WEBHOOK_TOKEN=""   # wysyłany jako Authorization: Bearer …

# Ochrona formularza rejestracji przed botami – Cloudflare Turnstile (darmowe, https://dash.cloudflare.com → Turnstile).
# Bez kluczy działa pole-pułapka i minimalny czas wypełnienia formularza.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Klucz do uruchamiania przypomnień e-mail (harmonogram zadań/cron raz dziennie):
#   https://twoja-domena.pl/api/cron/przypomnienia/?klucz=CRON_SECRET
# Wpisz długi losowy ciąg (min. 32 znaki). Puste = przypomnienia wyłączone.
CRON_SECRET=""

# Ustaw 1, jeśli ruch idzie przez Cloudflare (proxy) – wtedy limity prób liczą prawdziwy adres IP klienta (CF-Connecting-IP).
# Bez Cloudflare zostaw puste: adres bierzemy z nagłówka dopisanego przez serwer hostingu.
BEHIND_CLOUDFLARE=""

# Logowanie dwuetapowe dla administratorów – w produkcji obowiązkowe. 0 = wyłącz wymóg (niezalecane).
ADMIN_2FA_REQUIRED=""

# Kopie zapasowe uruchamiane przez aplikację raz na dobę (kopia.sh) i katalog kopii
AUTO_KOPIA=""
KOPIE_DIR=""

# Antywirus ClamAV (opcjonalnie): CLAMAV_HOST="127.0.0.1:3310" lub CLAMAV_SOCKET="/sciezka/clamd.sock".
# CLAMAV_REQUIRED=1 – odrzucaj pliki, gdy antywirus nie odpowiada. Wbudowana analiza plików działa zawsze.
CLAMAV_HOST=""
CLAMAV_SOCKET=""
CLAMAV_REQUIRED=""

# Maks. liczba połączeń z bazą na jeden proces aplikacji (domyślnie 5). Łącznie: procesy Node.js × DB_POOL + 1 (setup/kopia).
# Ustaw mniej niż limit połączeń użytkownika bazy na hostingu (max_user_connections).
DB_POOL=""

# Ceny energii (panel → Ceny energii, tylko dla administratorów): ceny rynkowe RCE pobierane automatycznie
# z publicznego API PSE (api.raporty.pse.pl) co godzinę. Wyłączenie: CENY_PSE=0.
# Opcjonalnie z crona: curl -H "Authorization: Bearer $CRON_SECRET" https://twoja-domena.pl/api/cron/ceny/
